# Copy this to .env and fill in your values
# Never commit .env to git

# ── Claude AI (required) ──────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Facebook (optional — for auto-posting) ────────
# Guide: https://developers.facebook.com/docs/pages/getting-started
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_TOKEN=your_long_lived_page_access_token

# ── X / Twitter (optional — for auto-posting) ────
# Guide: https://developer.twitter.com/en/portal/dashboard
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
X_BEARER_TOKEN=your_bearer_token

# ── Site ─────────────────────────────────────────
SITE_URL=https://nepaliwave.anuprijal.com.np
